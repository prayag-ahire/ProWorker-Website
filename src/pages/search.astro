---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchPage from '../components/react/SearchPage.jsx';
import { searchSeo, SITE_URL } from '../data/seo.js';

const { title, description, keywords } = searchSeo;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url: `${SITE_URL}/search`,
  inLanguage: 'en-IN',
  about: {
    '@type': 'Thing',
    name: 'Find skilled workers near me in India',
  },
};
---

<BaseLayout title={title} description={description} keywords={keywords} canonicalPath="/search" jsonLd={jsonLd}>
  <SearchPage client:load />
</BaseLayout>
