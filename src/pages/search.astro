---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchPage from '../components/react/SearchPage.jsx';

const title = 'Find Nearby Services & Homemade Products — ProWorker';
const description =
  'Search verified service providers and home-based sellers near you on ProWorker. Discover home repairs, homemade food, custom clothing, and crafts with 0% commission.';
---

<BaseLayout title={title} description={description} canonicalPath="/search">
  <SearchPage client:load />
</BaseLayout>
