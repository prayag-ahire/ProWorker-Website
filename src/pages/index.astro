---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomePage from '../components/react/HomePage.jsx';

const title = 'ProWorker — Local Services & Homemade Products Marketplace';
const description =
  'ProWorker is a free hyperlocal marketplace to discover nearby services and homemade products. Find trusted trades, home-cooked food, custom clothing, and crafts, or sell from home with 0% commission.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'ProWorker',
    url: 'https://proworker.co',
    description,
    logo: 'https://proworker.co/favicon.svg',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'ProWorker',
    url: 'https://proworker.co',
    description,
    potentialAction: {
      '@type': 'SearchAction',
      target: {
        '@type': 'EntryPoint',
        urlTemplate: 'https://proworker.co/search?profession={search_term_string}',
      },
      'query-input': 'required name=search_term_string',
    },
  },
];
---

<BaseLayout title={title} description={description} canonicalPath="/" jsonLd={jsonLd}>
  <HomePage client:load />
</BaseLayout>
