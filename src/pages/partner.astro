---
import BaseLayout from '../layouts/BaseLayout.astro';
import PartnerPage from '../components/react/PartnerPage.jsx';
import { partnerSeo, SITE_URL } from '../data/seo.js';

const { title, description, keywords } = partnerSeo;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url: `${SITE_URL}/partner`,
  inLanguage: 'en-IN',
  areaServed: {
    '@type': 'Country',
    name: 'India',
  },
};
---

<BaseLayout title={title} description={description} keywords={keywords} canonicalPath="/partner" jsonLd={jsonLd}>
  <PartnerPage client:load />
</BaseLayout>
