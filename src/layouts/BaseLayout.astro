---
import '../styles/global.css';
import '../styles/app.css';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import { SITE_LOCALE, SITE_LANG, DEFAULT_KEYWORDS } from '../data/seo.js';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  ogType?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  keywords?: string;
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  ogType = 'website',
  jsonLd,
  noindex = false,
  keywords = DEFAULT_KEYWORDS,
} = Astro.props;

const siteUrl = Astro.site?.href.replace(/\/$/, '') || 'https://proworker.co';
const canonical = new URL(canonicalPath, siteUrl).href;
const ogImage = new URL('/og-image.jpg', siteUrl).href;
---

<!doctype html>
<html lang={SITE_LANG}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en-IN" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <link rel="dns-prefetch" href="https://play.google.com" />
    <link rel="preconnect" href="https://play.google.com" crossorigin />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    )}

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="ProWorker" />
    <meta name="application-name" content="ProWorker" />
    <meta name="apple-mobile-web-app-title" content="ProWorker" />
    <meta name="geo.region" content="IN" />
    <meta name="geo.placename" content="India" />
    <meta name="language" content="English" />
    <meta name="coverage" content="India" />
    <meta name="target" content="India" />
    <meta name="rating" content="general" />
    <meta name="theme-color" content="#2563EB" />
    <meta name="format-detection" content="telephone=no" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="ProWorker" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="ProWorker — Workers platform in India" />
    <meta property="og:locale" content={SITE_LOCALE} />
    <meta property="og:country-name" content="India" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
  </head>
  <body>
    <slot />
    <WhatsAppFloat />
    <script is:inline>
      (function () {
        var hash = window.location.hash || '';
        if (!hash || hash.length < 2) return;
        var path = hash.slice(1);
        var query = '';
        var qIndex = path.indexOf('?');
        if (qIndex !== -1) {
          query = path.slice(qIndex);
          path = path.slice(0, qIndex);
        }
        var map = {
          search: '/search',
          privacy: '/privacy',
          signin: '/sign-in',
          deleteaccount: '/delete-account',
          childsafety: '/child-safety',
          partner: '/partner',
          'sales-partner': '/partner',
          'growth-partner': '/partner',
          store: '/store',
        };
        var target = map[path];
        if (target) {
          window.location.replace(target + query);
        }
      })();
    </script>
  </body>
</html>
